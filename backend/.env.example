# Server
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Auth
JWT_SECRET=your-long-random-secret

# Frontend (password-reset links + optional CORS fallback)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://your-app.vercel.app

# Cloudinary
CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

# Email (Brevo)
BREVO_API_KEY=
EMAIL_USER=
